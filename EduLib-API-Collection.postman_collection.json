      "name": "2. POST /emprestimos",
      "item": [
        {
          "name": "POST /emprestimos - sucesso (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const j = pm.response.json();",
                  "[\"id_emprestimo\",\"aluno_matricula\",\"livro_titulo\",\"data_emprestimo\",\"data_devolucao_prevista\",\"data_devolucao_real\",\"multa_cobrada_reais\",\"status\"]",
                  "  .forEach(k => pm.expect(j, \"campo \" + k).to.have.property(k));",
                  "",
                  "pm.test(\"Empréstimo nasce ATIVO, sem devolução real e sem multa\", () => {",
                  "  pm.expect(j.status).to.eql(\"ATIVO\");",
                  "  pm.expect(j.data_devolucao_real).to.be.null;",
                  "  pm.expect(j.multa_cobrada_reais).to.eql(0);",
                  "});",
                  "pm.test(\"Prazo previsto = data do empréstimo + 14 dias\", () => {",
                  "  const ini = new Date(j.data_emprestimo + \"T00:00:00Z\");",
                  "  const fim = new Date(j.data_devolucao_prevista + \"T00:00:00Z\");",
                  "  pm.expect((fim - ini) / 86400000).to.eql(14);",
                  "});",
                  "pm.collectionVariables.set(\"idEmprestimo\", String(j.id_emprestimo));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/emprestimos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "emprestimos"
