      "name": "1. Livros",
      "item": [
        {
          "name": "GET /livros - listar acervo (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "pm.test(\"Livros expõem somente os campos do DTO\", () => {",
                  "  const l = pm.response.json()[0];",
                  "  if (!l) return;",
                  "  [\"id_livro\",\"titulo\",\"autor\",\"isbn\",\"exemplares_disponiveis\"].forEach(k => pm.expect(l).to.have.property(k));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/livros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "livros"
              ]
            },
            "description": "Contrato: 200 OK com array de livros."
          }
        },
        {
          "name": "GET /livros?busca=termo - busca com resultado (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna array com ao menos 1 livro\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/livros?busca={{termoBusca}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "livros"
              ],
              "query": [
                {
                  "key": "busca",
                  "value": "{{termoBusca}}"
                }
              ]
            },
            "description": "Ajuste a variável termoBusca para um título existente no seed do H2."
          }
        },
        {
          "name": "GET /livros?busca=inexistente - sem resultado (200, array vazio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Array vazio\", () => pm.expect(pm.response.json()).to.eql([]));"
