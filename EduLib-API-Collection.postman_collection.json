      "name": "4. PUT /emprestimos/{id}/devolucao",
      "item": [
        {
          "name": "PUT devolução no prazo (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "[\"id_emprestimo\",\"aluno_matricula\",\"livro_titulo\",\"data_emprestimo\",\"data_devolucao_prevista\",\"data_devolucao_real\",\"multa_cobrada_reais\",\"status\"]",
                  "  .forEach(k => pm.expect(j, \"campo \" + k).to.have.property(k));",
                  "",
                  "pm.test(\"Devolvido no prazo: DEVOLVIDO, data real preenchida, multa 0\", () => {",
                  "  pm.expect(j.status).to.eql(\"DEVOLVIDO\");",
                  "  pm.expect(j.data_devolucao_real).to.eql(pm.collectionVariables.get(\"dataHoje\"));",
                  "  pm.expect(j.multa_cobrada_reais).to.eql(0);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0,10);",
                  "const hoje = new Date();",
                  "const atraso = new Date(); atraso.setDate(atraso.getDate() + 20);",
                  "pm.collectionVariables.set(\"dataHoje\", fmt(hoje));",
                  "pm.collectionVariables.set(\"dataAtraso\", fmt(atraso));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
